# ==============================================================================
# CampusCare Backend Environment Configuration (.env.example)
# Copy this file to .env and configure with your actual Supabase credentials.
# Never commit credentials, service role keys, or database passwords to git.
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Example: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_database_password

# Supabase Project API Settings
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
# Supabase JWT Configuration:
# Use SUPABASE_JWT_SECRET for HS256 (symmetric) projects.
# For asymmetric projects (RS256 / ES256), configure SUPABASE_JWT_PUBLIC_KEY (PEM format) or provide SUPABASE_URL for automatic JWKS lookup.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Storage Bucket for Issue Evidence (Private bucket)
SUPABASE_STORAGE_BUCKET=issue-evidence

# Allowed Origins for CORS during frontend development
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
